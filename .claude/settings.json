{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/session_start.sh", "timeout": 15 }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/post_edit_check.sh", "timeout": 120, "statusMessage": "Running tests / type-check" }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/stop_check.sh", "timeout": 180, "statusMessage": "Final check: backend tests + frontend type-check" }
        ]
      }
    ]
  },
  "permissions": {
    "deny": [
      "Edit(backend/.venv/**)",
      "Edit(frontend/node_modules/**)"
    ]
  }
}
